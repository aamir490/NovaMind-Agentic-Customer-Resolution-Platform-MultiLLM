# Optional: copy to .env for docker compose. No credentials belong here.
NOVAMIND_PORT=8080
# For compose.auth.yaml only, set a host path in your shell:
# NOVAMIND_AUTH_SOURCE=C:/private/novamind-auth.json
# Optional compose.gemini.yaml: inject GEMINI_API_KEY through a trusted runtime
# secret mechanism into the invoking process, and set GEMINI_MODEL explicitly.
# Do not put the key in this file or any frontend/build configuration.
# Optional compose.groq.yaml: inject GROQ_API_KEY into the invoking process.
# GROQ_MODEL defaults to openai/gpt-oss-20b; the overlay explicitly selects Groq.
# Use one provider overlay. Do not store GROQ_API_KEY in this file.
